# Copy to deploy/.env and fill in. deploy/.env is gitignored - never commit it.

# Database
DB_USER=meditracker
DB_PASSWORD=

# JWT signing secret, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Public URL (no trailing slash). Used in email links.
APP_BASE_URL=https://medi.koala.rip

# First admin account, created on startup only if no admin exists yet.
# You can remove these after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP for verification / password reset emails.
# Leave MAIL_HOST empty to print email links to the backend log instead (local testing).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=MediTracker <no-reply@koala.rip>

# Port the site listens on, on 127.0.0.1 only
FRONTEND_PORT=8081

# Cloudflare Tunnel token (only needed with: docker compose --profile tunnel up -d)
TUNNEL_TOKEN=
